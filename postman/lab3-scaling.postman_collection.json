      "description": "Register, refresh, heartbeat, look up and deregister an instance, plus the documented 400 and 404 errors. Uses a probe service that no real component calls.",
      "item": [
        {
          "name": "Register an instance (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201 Created\", () => pm.response.to.have.status(201));",
                  "const i = pm.response.json();",
                  "pm.test(\"Instance stored as sent\", () => {",
                  "  pm.expect(i.service_name).to.eql(\"lab3-postman-probe\");",
                  "  pm.expect(i.instance_id).to.eql(\"probe-\" + pm.collectionVariables.get(\"run_id\"));",
                  "  pm.expect(i.health_path).to.eql(\"/health\");",
                  "  pm.expect(i.url).to.match(/^http:\\/\\/probe-.*\\.invalid:8080$/);",
                  "});"
                ]
              }
            }
