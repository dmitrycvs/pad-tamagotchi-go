{
  "info": {
    "_postman_id": "97626f57-ad60-5ddf-b3a8-6196082c49e7",
    "name": "Tamagotchi Go — Service Discovery",
    "description": "Service Discovery registry API (port 8761): health, listing, register, re-register, heartbeat, deregister and the documented 400/404 errors. Needs no token or environment. Run top to bottom, or send requests one by one (Register sets probe_id for the requests after it). Contract: service-discovery/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const h = pm.response.json();",
              "pm.test(\"Shared health shape\", () => {",
              "  pm.expect(h.status).to.eql(\"ok\");",
              "  pm.expect(h.service).to.eql(\"service-discovery\");",
              "  [\"instance_id\", \"uptime_seconds\", \"in_flight\", \"max_concurrent\", \"registered_instances\"]",
              "    .forEach(k => pm.expect(h, k).to.have.property(k));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{registry_url}}/health",
          "host": [
            "{{registry_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "The registry's own status in the shared health shape, plus registered_instances."
      }
    },
    {
      "name": "List all services",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const services = pm.response.json().services;",
              "pm.test(\"Services listed, sorted by name\", () => {",
              "  pm.expect(services).to.be.an(\"array\").that.is.not.empty;",
              "  const names = services.map(s => s.name);",
              "  pm.expect(names).to.eql([...names].sort());",
              "});",
              "pm.test(\"Every instance has an address and its latest health check\", () => services.forEach(s =>",
              "  s.instances.forEach(i => {",
              "    pm.expect(i.url, i.instance_id).to.match(/^http:\\/\\//);",
              "    pm.expect(i, i.instance_id).to.have.property(\"health\");",
              "  })));",
              "console.log(services.map(s => `${s.name}: ${s.instances.length}`).join(\", \"));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{registry_url}}/api/registry/services",
          "host": [
            "{{registry_url}}"
          ],
          "path": [
            "api",
            "registry",
            "services"
          ]
        },
        "description": "Every service and its instances, with each instance's latest /health result (polled every 15 s)."
      }
    },
    {
      "name": "Instances of one service",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Instances of tamagotchi-service, sorted by id\", () => {",
              "  pm.expect(body.name).to.eql(\"tamagotchi-service\");",
              "  const ids = body.instances.map(i => i.instance_id);",
              "  pm.expect(ids).to.not.be.empty;",
              "  pm.expect(ids).to.eql([...ids].sort());",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{registry_url}}/api/registry/services/tamagotchi-service/instances",
          "host": [
            "{{registry_url}}"
          ],
          "path": [
            "api",
            "registry",
            "services",
            "tamagotchi-service",
            "instances"
          ]
        },
        "description": "Change the service name in the URL to look at another service."
      }
    },
    {
      "name": "Register an instance (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A fresh fake instance per run. Its host does not resolve, and nothing routes to postman-probe.",
              "pm.collectionVariables.set(\"probe_id\", \"probe-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201 Created\", () => pm.response.to.have.status(201));",
              "const i = pm.response.json();",
              "pm.test(\"Stored as sent, health_path defaults to /health\", () => {",
              "  pm.expect(i.instance_id).to.eql(pm.collectionVariables.get(\"probe_id\"));",
              "  pm.expect(i.health_path).to.eql(\"/health\");",
              "  pm.expect(i.registered_at).to.eql(i.last_heartbeat_at);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{registry_url}}/api/registry/instances",
          "host": [
            "{{registry_url}}"
          ],
          "path": [
            "api",
            "registry",
            "instances"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"service_name\": \"postman-probe\",\n  \"instance_id\": \"{{probe_id}}\",\n  \"host\": \"{{probe_id}}.invalid\",\n  \"port\": 8080\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Registers a fake instance of a service nothing calls. Without heartbeats the registry drops it after 30 s."
      }
    },
    {
      "name": "Register the same instance again (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200: re-registration is idempotent\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
