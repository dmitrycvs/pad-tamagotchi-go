{
  "info": {
    "_postman_id": "041830c2-7211-4d15-989c-81d9161c773d",
    "name": "Tamagotchi Go — Tamagotchi Service",
    "description": "Tamagotchi Service collection based on the provided route list and shared Communication Contract. Create a Tamagotchi stores tamagotchi_id. User routes use jwt; create, XP, and transfer use service_jwt.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Reference",
      "item": [
        {
          "name": "Health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));", "pm.test(\"Response is JSON\", () => pm.response.to.be.json);"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] },
            "description": "Health endpoint supplied by the service owner. Only status and JSON are asserted because the private implementation is unavailable."
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"service\": \"tamagotchi-service\",\n  \"status\": \"ok\"\n}" }]
        },
        {
          "name": "Get Type Advantage Matrix",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.types).to.be.an(\"array\");", "pm.expect(body.multipliers).to.be.an(\"object\");"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/tamagotchis/types", "host": ["{{base_url}}"], "path": ["api", "tamagotchis", "types"] }
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"cycle\": [\"flame\", \"nature\", \"earth\", \"electric\", \"water\", \"shadow\"],\n  \"multipliers\": { \"advantage\": 1.5, \"neutral\": 1.0, \"disadvantage\": 0.75 },\n  \"types\": [\n    { \"type\": \"flame\", \"strong_against\": \"nature\", \"weak_against\": \"shadow\" },\n    { \"type\": \"nature\", \"strong_against\": \"earth\", \"weak_against\": \"flame\" },\n    { \"type\": \"earth\", \"strong_against\": \"electric\", \"weak_against\": \"nature\" },\n    { \"type\": \"electric\", \"strong_against\": \"water\", \"weak_against\": \"earth\" },\n    { \"type\": \"water\", \"strong_against\": \"shadow\", \"weak_against\": \"electric\" },\n    { \"type\": \"shadow\", \"strong_against\": \"flame\", \"weak_against\": \"water\" }\n  ]\n}" }]
        }
      ]
    },
    {
      "name": "Tamagotchis",
      "item": [
        {
          "name": "Create a Tamagotchi",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.expect(body.tamagotchi_id).to.be.a(\"string\").and.not.empty;", "pm.collectionVariables.set(\"tamagotchi_id\", body.tamagotchi_id);"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{service_jwt}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"owner_id\": \"{{owner_id}}\",\n  \"package_id\": \"{{package_id}}\",\n  \"name\": \"Postman Tama {{$timestamp}}\",\n  \"type\": \"flame\",\n  \"sprite_ref\": \"{{package_id}}/sprites/postman-tama.png\",\n  \"stats\": {\n    \"hunger\": 100,\n    \"tiredness\": 0,\n    \"happiness\": 80\n  }\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/tamagotchis", "host": ["{{base_url}}"], "path": ["api", "tamagotchis"] },
            "description": "Internal endpoint; requires service_jwt."
          },
          "response": [
            { "name": "201 Created", "status": "Created", "code": 201, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"tamagotchi_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n  \"owner_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"package_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"type\": \"flame\",\n  \"level\": 1,\n  \"xp\": 0,\n  \"is_primary\": true\n}" },
            { "name": "401 Unauthorized", "status": "Unauthorized", "code": 401, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"error\": \"Unauthorized.\"\n}" }
          ]
        },
        {
          "name": "List a User's Tamagotchis",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.owner_id).to.eql(pm.collectionVariables.get(\"owner_id\"));", "pm.expect(body.secondary).to.be.an(\"array\");"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/tamagotchis?owner_id={{owner_id}}", "host": ["{{base_url}}"], "path": ["api", "tamagotchis"], "query": [{ "key": "owner_id", "value": "{{owner_id}}" }] }
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"owner_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"primary\": { \"tamagotchi_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\", \"name\": \"Postman Tama\", \"type\": \"flame\", \"level\": 1 },\n  \"secondary\": []\n}" }]
        },
        {
          "name": "Get a Tamagotchi",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().tamagotchi_id).to.eql(pm.collectionVariables.get(\"tamagotchi_id\"));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/tamagotchis/{{tamagotchi_id}}", "host": ["{{base_url}}"], "path": ["api", "tamagotchis", "{{tamagotchi_id}}"] }
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"tamagotchi_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n  \"owner_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"package_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"name\": \"Postman Tama\",\n  \"type\": \"flame\",\n  \"level\": 1,\n  \"xp\": 0,\n  \"sprite_ref\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa/sprites/postman-tama.png\",\n  \"stats\": { \"hunger\": 100, \"tiredness\": 0, \"happiness\": 80 },\n  \"is_primary\": true\n}" }]
        },
        {
          "name": "Update Package-Local Statistics",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().stats.hunger).to.eql(90);"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"stats\": {\n    \"hunger\": 90,\n    \"tiredness\": 55\n  }\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/tamagotchis/{{tamagotchi_id}}/stats", "host": ["{{base_url}}"], "path": ["api", "tamagotchis", "{{tamagotchi_id}}", "stats"] }
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"tamagotchi_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n  \"stats\": { \"hunger\": 90, \"tiredness\": 55, \"happiness\": 80 },\n  \"updated_at\": \"2026-09-24T12:05:00Z\"\n}" }]
        },
        {
          "name": "Set Primary Tamagotchi",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Request succeeds\", () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"owner_id\": \"{{owner_id}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/tamagotchis/{{tamagotchi_id}}/primary", "host": ["{{base_url}}"], "path": ["api", "tamagotchis", "{{tamagotchi_id}}", "primary"] }
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"tamagotchi_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n  \"owner_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"is_primary\": true\n}" }]
        },
        {
          "name": "Award XP",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.have.property(\"xp\");"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{service_jwt}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"event_id\": \"{{$guid}}\",\n  \"amount\": 60,\n  \"reason\": \"battle_won\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/tamagotchis/{{tamagotchi_id}}/xp", "host": ["{{base_url}}"], "path": ["api", "tamagotchis", "{{tamagotchi_id}}", "xp"] },
            "description": "Internal idempotent endpoint; requires service_jwt."
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"tamagotchi_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n  \"xp\": 60,\n  \"level\": 1,\n  \"leveled_up\": false\n}" }]
        },
        {
          "name": "Transfer Ownership",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().owner_id).to.eql(pm.collectionVariables.get(\"other_user_id\"));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{service_jwt}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"event_id\": \"{{$guid}}\",\n  \"from_user_id\": \"{{owner_id}}\",\n  \"to_user_id\": \"{{other_user_id}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/tamagotchis/{{tamagotchi_id}}/transfer", "host": ["{{base_url}}"], "path": ["api", "tamagotchis", "{{tamagotchi_id}}", "transfer"] },
            "description": "Internal idempotent endpoint; run last because ownership changes."
          },
          "response": [
            { "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"tamagotchi_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n  \"owner_id\": \"22222222-2222-4222-8222-222222222222\",\n  \"is_primary\": false,\n  \"previous_owner_id\": \"11111111-1111-4111-8111-111111111111\"\n}" },
            { "name": "409 Ownership changed", "status": "Conflict", "code": 409, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"error\": \"Tamagotchi no longer belongs to the stated previous owner.\"\n}" }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8083", "type": "string" },
    { "key": "jwt", "value": "", "type": "string", "description": "JWT for owner_id; keep empty in the exported collection." },
    { "key": "service_jwt", "value": "", "type": "string", "description": "Keep empty in the exported collection." },
    { "key": "owner_id", "value": "11111111-1111-4111-8111-111111111111", "type": "string" },
    { "key": "other_user_id", "value": "22222222-2222-4222-8222-222222222222", "type": "string" },
    { "key": "package_id", "value": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa", "type": "string" },
    { "key": "tamagotchi_id", "value": "", "type": "string", "description": "Filled by Create a Tamagotchi." }
  ]
}
