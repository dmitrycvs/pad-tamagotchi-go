# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.
#
#   cp .env.example .env

# --- Database ---------------------------------------------------------------
POSTGRES_USER=tamagotchi
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
# Lab 5: the replication role's password (empty = POSTGRES_PASSWORD) and the standbys' host ports.
POSTGRES_REPLICATION_PASSWORD=
POSTGRES_1_PORT=5434
POSTGRES_2_PORT=5435
# Failover monitor: a check every 2 s, promotion after 3 failures (it also uses DISCORD_WEBHOOK_URL).
FAILOVER_CHECK_INTERVAL_SECONDS=2
FAILOVER_FAILURE_THRESHOLD=3
FAILOVER_STARTUP_GRACE_SECONDS=30

# --- Data warehouse and ETL (Lab 5) -----------------------------------------
# Empty DW_USER and DW_PASSWORD = the POSTGRES_ ones.
DW_USER=
DW_PASSWORD=
DW_PORT=5433
TAG_ETL=1.0.0
ETL_HOST_PORT=8095
# A whole number with s, m or h.
ETL_INTERVAL=5m
ETL_OVERLAP=2m
ETL_LOOKBACK=24h

# --- Secrets ----------------------------------------------------------------
# JWT_SECRET signs user tokens issued by the User Management Service.
# SERVICE_JWT_SECRET signs service-to-service tokens; every service must share it.
# NOTE: Must be at least 32 characters (256 bits) for HMAC-SHA256 (.NET services enforce this).
JWT_SECRET=change_me_to_a_secret_with_at_least_32_characters
SERVICE_JWT_SECRET=change_me_to_a_service_secret_at_least_32_chars

# --- Firebase (Notification Service) ----------------------------------------
# FIREBASE_CREDENTIALS_JSON holds the service-account JSON as a single line.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# --- API Gateway ------------------------------------------------------------
# Lab 2: the gateway validates JWTs and does NOT forward the Authorization header.
# Set to true only as a temporary bridge while a service still validates JWTs itself.
GATEWAY_FORWARD_AUTHORIZATION=false
# Required. Must match across the gateway and services for REST identity headers.
GATEWAY_SHARED_SECRET=change_me_to_a_random_gateway_secret
# Task timeout and concurrent task limit (exceeded -> 504 / 503).
GATEWAY_REQUEST_TIMEOUT=12s
GATEWAY_MAX_CONCURRENT_REQUESTS=200
# Public WebSocket base URLs handed to clients by POST /api/realtime/...
# Each points at the first port of the service's host port range (one port per replica).
WS_PUBLIC_URL_BATTLE=ws://localhost:8082
WS_PUBLIC_URL_MAP=ws://localhost:8085
WS_PUBLIC_URL_MONSTER_RAID=ws://localhost:8088
WS_PUBLIC_URL_GUILD=ws://localhost:8091
# When discovery is enabled, map actual instance IDs to their published ports.
# Generate with: python3 scripts/realtime-instance-urls.py
WS_PUBLIC_INSTANCE_URLS={}

# Guild replicas share this event channel; history and outbox stay in PostgreSQL.
REDIS_URL=redis://redis:6379/0
GUILD_REDIS_CHANNEL=tamagotchi:guild:events

# --- Service task limits ----------------------------------------------------
# Per-service task timeout in seconds; keep it below GATEWAY_REQUEST_TIMEOUT so the
# service's own 504 reaches the client first. Exceeded -> 504.
REQUEST_TIMEOUT_SECONDS=8
# Per-service concurrent task limit. Exceeded -> 503 with Retry-After: 1.
MAX_CONCURRENT_REQUESTS=100

# --- Service Discovery ------------------------------------------------------
# Every service registers here on startup and the gateway routes to the registered
# instances. Leave as is inside Docker; empty disables registration and discovery routing.
SERVICE_DISCOVERY_URL=http://service-discovery:8761

# --- Replicas (Lab 3) -------------------------------------------------------
# Instances started per business service. Battle, Map, Monster Raid and Guild publish
# one host port per replica from a range of three, so keep those at 3 or fewer.
REPLICAS_USER_MANAGEMENT=2
REPLICAS_BATTLE=2
REPLICAS_TAMAGOTCHI=2
REPLICAS_NOTIFICATION=2
REPLICAS_MAP=2
REPLICAS_MONSTER_RAID=2
REPLICAS_GUILD=2
REPLICAS_PACKAGE_REGISTRY=2

# --- Map Service ------------------------------------------------------------
PROXIMITY_THRESHOLD_METERS=6

# --- DockerHub namespaces ---------------------------------------------------
# The DockerHub account each teammate publishes their images under.
DOCKERHUB_USER_DMITRII=dmitrycvs
DOCKERHUB_USER_MAXIM=maxkostov
DOCKERHUB_USER_DENIS=takima
DOCKERHUB_USER_FILIP=filipel2004

# --- Image tags -------------------------------------------------------------
# Override to pin a specific version; defaults match docker-compose.yml.
TAG_USER_MANAGEMENT=5.0.0
TAG_BATTLE=5.0.1
TAG_TAMAGOTCHI=4.1.0
TAG_NOTIFICATION=4.1.0
TAG_MAP=2.4.0
TAG_MONSTER_RAID=2.4.0
TAG_GUILD=3.3.0
TAG_PACKAGE_REGISTRY=3.3.0
TAG_GATEWAY=3.3.0
TAG_SERVICE_DISCOVERY=3.6.0

# --- Lab 3 alerts and circuit breakers --------------------------------------
# Secret: leave empty to disable Discord; never commit a real webhook URL.
DISCORD_WEBHOOK_URL=
DISCORD_MIN_INTERVAL=5s
DISCORD_TIMEOUT=3s
DISCORD_DEDUP_WINDOW=60s
DISCORD_QUEUE_CAPACITY=100
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# Go services: seconds; empty derives from REQUEST_TIMEOUT_SECONDS x 3.5.
CIRCUIT_BREAKER_WINDOW_SECONDS=
# Empty = 5 s in Compose: a database failover must not keep breakers open (README, Lab 5).
CIRCUIT_BREAKER_COOLDOWN_SECONDS=
# These versions must be published before the CPR release PR is merged.

# --- Message Broker (Lab 4 step 1) -------------------------------------------
TAG_MESSAGE_BROKER=1.4.0
BROKER_REQUEST_TIMEOUT=10s
BROKER_CONNECT_TIMEOUT=2s
BROKER_MAX_CONCURRENT_REQUESTS=200
BROKER_QUEUE_CAPACITY=100
BROKER_WORKER_THREADS=0
BROKER_GRPC_THREADS=0
DISCOVERY_REFRESH_INTERVAL=5s
DISCOVERY_HEARTBEAT_INTERVAL=10s
# Java duration overrides; empty uses timeout x 3.5 and that same cooldown.
CIRCUIT_BREAKER_WINDOW=
CIRCUIT_BREAKER_COOLDOWN=

# --- Monitoring -------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_to_a_random_grafana_password

# --- Java runtime budgets ---------------------------------------------------
# Each Java process sees the shared Docker VM; bound its heap and CPU-derived
# thread pools so the three processes leave room for the business/monitoring stack.
GATEWAY_JAVA_OPTS=-Xms64m -Xmx256m -XX:ActiveProcessorCount=2
DISCOVERY_JAVA_OPTS=-Xms64m -Xmx256m -XX:ActiveProcessorCount=2
BROKER_JAVA_OPTS=-Xms64m -Xmx256m -XX:ActiveProcessorCount=2

# --- Message Broker durable queues (Lab 4) ------------------------------------
# Attempts before a message goes to the dead letter channel, and the backoff between them.
BROKER_RETRY_MAX_ATTEMPTS=5
BROKER_RETRY_INITIAL_BACKOFF=1s
BROKER_RETRY_MAX_BACKOFF=60s

# --- Lab 5: cache-router and cache shards -------------------------------------
# Every service gets CACHE_ROUTER_URL; empty disables caching (services read their database).
CACHE_ROUTER_URL=http://cache-router:8090
TAG_CACHE_ROUTER=1.0.0
# Host port of the cache-router for the demo (GET /ring, /ring/simulate). Not 8090: Monster Raid uses 8088-8090.
CACHE_ROUTER_HOST_PORT=8094
# Points per shard on the consistent hash ring; changing it moves keys.
CACHE_VIRTUAL_NODES=150
# One Redis command; a slower or stopped shard answers as a miss.
CACHE_SHARD_TIMEOUT=250ms
# Memory per shard; the least recently used key is evicted when full.
CACHE_SHARD_MAXMEMORY=64mb

# --- Lab 5: Message Broker saga transactions ----------------------------------
# How long POST /api/transactions waits before answering "running", and attempts per step / compensation.
BROKER_SAGA_WAIT=10s
BROKER_SAGA_STEP_ATTEMPTS=5
BROKER_SAGA_COMPENSATION_ATTEMPTS=10
