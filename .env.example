# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.
#
#   cp .env.example .env

# --- Database ---------------------------------------------------------------
POSTGRES_USER=tamagotchi
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- Secrets ----------------------------------------------------------------
# JWT_SECRET signs user tokens issued by the User Management Service.
# SERVICE_JWT_SECRET signs service-to-service tokens; every service must share it.
# NOTE: Must be at least 32 characters (256 bits) for HMAC-SHA256 (.NET services enforce this).
JWT_SECRET=change_me_to_a_secret_with_at_least_32_characters
SERVICE_JWT_SECRET=change_me_to_a_service_secret_at_least_32_chars

# --- Firebase (Notification Service) ----------------------------------------
# FIREBASE_CREDENTIALS_JSON holds the service-account JSON as a single line.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# --- API Gateway ------------------------------------------------------------
# Lab 2: the gateway validates JWTs and does NOT forward the Authorization header.
# Set to true only as a temporary bridge while a service still validates JWTs itself.
GATEWAY_FORWARD_AUTHORIZATION=false
# Required. Must match across the gateway and services for REST identity headers.
GATEWAY_SHARED_SECRET=change_me_to_a_random_gateway_secret
# Task timeout and concurrent task limit (exceeded -> 504 / 503).
GATEWAY_REQUEST_TIMEOUT=10s
GATEWAY_MAX_CONCURRENT_REQUESTS=200
# Public WebSocket base URLs handed to clients by POST /api/realtime/...
WS_PUBLIC_URL_BATTLE=ws://localhost:8082
WS_PUBLIC_URL_MAP=ws://localhost:8085
WS_PUBLIC_URL_MONSTER_RAID=ws://localhost:8086
WS_PUBLIC_URL_GUILD=ws://localhost:8087

# --- Service task limits ----------------------------------------------------
# Per-service task timeout in seconds; keep it below GATEWAY_REQUEST_TIMEOUT so the
# service's own 504 reaches the client first. Exceeded -> 504.
REQUEST_TIMEOUT_SECONDS=8
# Per-service concurrent task limit. Exceeded -> 503 with Retry-After: 1.
MAX_CONCURRENT_REQUESTS=100

# --- Map Service ------------------------------------------------------------
PROXIMITY_THRESHOLD_METERS=6

# --- DockerHub namespaces ---------------------------------------------------
# The DockerHub account each teammate publishes their images under.
DOCKERHUB_USER_DMITRII=dmitrycvs
DOCKERHUB_USER_MAXIM=maxkostov
DOCKERHUB_USER_DENIS=takima
DOCKERHUB_USER_FILIP=filipel2004

# --- Image tags -------------------------------------------------------------
# Override to pin a specific version; defaults match docker-compose.yml.
TAG_USER_MANAGEMENT=2.0.1
TAG_BATTLE=2.0.1
TAG_TAMAGOTCHI=2.0.1
TAG_NOTIFICATION=2.0.1
TAG_MAP=2.0.2
TAG_MONSTER_RAID=2.0.2
TAG_GUILD=2.0.0
TAG_PACKAGE_REGISTRY=2.0.0
TAG_GATEWAY=2.0.1
