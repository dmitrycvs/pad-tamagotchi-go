            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"guild_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"messages\": [\n    {\n      \"message_id\": \"cccccccc-cccc-4ccc-8ccc-cccccccccccc\",\n      \"author_id\": \"11111111-1111-4111-8111-111111111111\",\n      \"username\": \"user_11111111\",\n      \"content\": \"who is joining the raid?\",\n      \"sent_at\": \"2026-09-24T12:05:00Z\"\n    }\n  ]\n}"
            },
            {
              "name": "403 Guild membership required",
              "status": "Forbidden",
              "code": 403,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"error\": \"Guild membership required.\"\n}"
