          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/packages/00000000-0000-0000-0000-000000000002",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Battle Service (unknown id, 404 from the service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404 from the service, not the gateway\", () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.headers.get(\"X-Gateway-Error\")).to.be.undefined;",
                  "});",
                  "lab3.expectServedBy(pm, \"battle-service\");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/battles/00000000-0000-0000-0000-000000000002",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Round-robin load balancing (Grade 6)",
      "description": "Sends the same request several times in a row. The gateway must rotate through the service's replicas: no instance twice in a row, and every replica used.",
      "item": [
        {
          "name": "Round-robin across tamagotchi-service replicas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const seen = JSON.parse(pm.collectionVariables.get(\"rr_seen\") || \"[]\");",
                  "seen.push(lab3.upstream(pm));",
                  "const replicas = lab3.instancesOf(pm, \"tamagotchi-service\");",
                  "const rounds = replicas.length * 2;",
                  "",
                  "if (seen.length < rounds) {",
                  "  pm.collectionVariables.set(\"rr_seen\", JSON.stringify(seen));",
                  "  lab3.repeat(pm, postman);",
                  "} else {",
                  "  pm.collectionVariables.set(\"rr_seen\", \"[]\");",
                  "  console.log(\"Round-robin order:\", seen.join(\" -> \"));",
                  "  pm.test(`Every replica served a request (${seen.join(\" -> \")})`, () =>",
                  "    pm.expect(new Set(seen)).to.have.property(\"size\", replicas.length));",
                  "  pm.test(\"No replica served two requests in a row\", () =>",
                  "    seen.slice(1).forEach((id, i) => pm.expect(id).to.not.eql(seen[i])));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/tamagotchis/types",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "5. Realtime connections are routed to a registered instance",
      "description": "WebSocket negotiation picks a registered guild-service instance and returns its id, so a client always reconnects to the instance that holds its session.",
      "item": [
        {
          "name": "Negotiate a guild chat WebSocket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Direct WebSocket URL\", () => pm.expect(body.url).to.match(/^wss?:\\/\\//));",
                  "pm.test(\"Negotiated with a registered guild-service instance\", () =>",
                  "  pm.expect(lab3.instancesOf(pm, \"guild-service\")).to.include(body.instance_id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/realtime/guilds/{{guild_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Circuit breaker removes a failing instance; expired instances leave (Grades 7, 10)",
      "description": "Registers a fake tamagotchi-service instance whose host does not resolve. The round-robin sends it every few requests; after 3 failures its circuit breaker opens, the gateway stops using it and removes it from Service Discovery. The real replicas keep serving. Then checks that the instance registered in folder 3 without heartbeats was dropped after the 30 s heartbeat timeout. Takes about 40 s in total.",
      "item": [
        {
          "name": "Add a broken tamagotchi-service instance",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"broken_registered_at\", Date.now().toString());",
                  "pm.collectionVariables.set(\"cb_results\", \"[]\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{registry_url}}/api/registry/instances",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_name\": \"tamagotchi-service\",\n  \"instance_id\": \"broken-{{run_id}}\",\n  \"host\": \"broken-{{run_id}}.invalid\",\n  \"port\": 8080\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Send traffic until the breaker trips",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The gateway reloads the registry every 5 s; wait until it has seen the new instance.",
                  "const since = Date.now() - Number(pm.collectionVariables.get(\"broken_registered_at\"));",
                  "if (JSON.parse(pm.collectionVariables.get(\"cb_results\") || \"[]\").length === 0 && since < 7000) {",
                  "  setTimeout(() => {}, 7000 - since);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const results = JSON.parse(pm.collectionVariables.get(\"cb_results\") || \"[]\");",
                  "results.push({ status: pm.response.code, instance: lab3.upstream(pm) || \"gateway\" });",
                  "pm.collectionVariables.set(\"cb_results\", JSON.stringify(results));",
                  "const broken = \"broken-\" + pm.collectionVariables.get(\"run_id\");",
                  "const failures = results.filter(r => r.status === 503).length;",
                  "",
                  "// Keep sending until the broken instance failed 3 times (breaker opens), then a few more.",
                  "const enough = failures >= 3 && results.length >= 15;",
                  "if (!enough && results.length < 40) {",
                  "  lab3.repeat(pm, postman);",
                  "} else {",
                  "  console.log(\"Responses:\", results.map(r => r.status).join(\" \"));",
                  "  pm.test(\"The broken instance received traffic and failed (503)\", () => pm.expect(failures).to.be.at.least(1));",
                  "  pm.test(\"The breaker opened after 3 failures: no more 503s afterwards\", () => {",
                  "    const lastFailure = results.map(r => r.status).lastIndexOf(503);",
                  "    pm.expect(failures).to.eql(3);",
                  "    pm.expect(results.slice(lastFailure + 1).every(r => r.status === 200)).to.be.true;",
                  "  });",
                  "  pm.test(\"Healthy replicas kept serving\", () =>",
                  "    pm.expect(results.filter(r => r.status === 200).length).to.be.above(failures));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/tamagotchis/types",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "The gateway removed the broken instance from Service Discovery",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Removal runs on a worker thread right after the trip; give it a moment.",
                  "setTimeout(() => {}, 1500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().instances.map(i => i.instance_id);",
                  "const age = (Date.now() - Number(pm.collectionVariables.get(\"broken_registered_at\"))) / 1000;",
                  "pm.test(\"broken instance deregistered by the gateway\", () =>",
                  "  pm.expect(ids).to.not.include(\"broken-\" + pm.collectionVariables.get(\"run_id\")));",
                  "pm.test(`Removed within ${age.toFixed(0)} s, before the 30 s heartbeat timeout could have`, () =>",
                  "  pm.expect(age).to.be.below(30));",
                  "pm.test(\"The real replicas are still registered\", () =>",
                  "  pm.expect(ids.filter(id => lab3.instancesOf(pm, \"tamagotchi-service\").includes(id))).to.have.length.of.at.least(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{registry_url}}/api/registry/services/tamagotchi-service/instances",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "An instance without heartbeats expires after 30 s",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Heartbeat timeout 30 s + expiry sweep every 5 s: wait until 37 s after registration.",
                  "const waitMs = 37000 - (Date.now() - Number(pm.collectionVariables.get(\"expiry_registered_at\")));",
                  "if (waitMs > 0) setTimeout(() => {}, waitMs);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const age = (Date.now() - Number(pm.collectionVariables.get(\"expiry_registered_at\"))) / 1000;",
                  "pm.test(`Dropped by the registry (${age.toFixed(0)} s after registering, no heartbeat)`, () =>",
                  "  pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{registry_url}}/api/registry/services/lab3-expiry-probe/instances",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}
