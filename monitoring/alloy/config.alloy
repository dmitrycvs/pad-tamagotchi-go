local.file_match "tamagotchi" {
  path_targets = [{"__path__" = "/var/log/tamagotchi/*.log", "job" = "tamagotchi"}]
  sync_period = "5s"
}

discovery.relabel "log_labels" {
  targets = local.file_match.tamagotchi.targets
  rule {
    source_labels = ["__path__"]
    regex = ".*/(message-broker|guild-service|package-registry-service|api-gateway|service-discovery|tamagotchi-service|notification-service)(-.*)?\\.log"
    target_label = "service"
    replacement = "$1"
  }
}

loki.source.file "tamagotchi" {
  targets = discovery.relabel.log_labels.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
