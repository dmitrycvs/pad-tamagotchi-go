  "item": [
    {
      "name": "1. Status endpoints and registration (Grades 3-4)",
      "description": "Every component exposes GET /health in the shared shape, and every business service runs 2 replicas that registered with Service Discovery on startup.",
      "item": [
        {
          "name": "Service Discovery health",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// One id per run, so repeated runs never collide.",
                  "pm.collectionVariables.set(\"run_id\", Date.now().toString() + Math.floor(Math.random() * 1000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const h = pm.response.json();",
                  "pm.test(\"Shared health shape\", () => {",
                  "  pm.expect(h.status).to.eql(\"ok\");",
                  "  pm.expect(h.service).to.eql(\"service-discovery\");",
                  "  [\"instance_id\", \"uptime_seconds\", \"in_flight\", \"max_concurrent\", \"registered_instances\"]",
                  "    .forEach(k => pm.expect(h, k).to.have.property(k));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{registry_url}}/health",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Gateway health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const h = pm.response.json();",
                  "pm.test(\"Shared health shape\", () => {",
                  "  pm.expect(h.status).to.eql(\"ok\");",
                  "  pm.expect(h.service).to.eql(\"api-gateway\");",
                  "  pm.expect(h.max_concurrent).to.be.above(0);",
                  "  [\"instance_id\", \"uptime_seconds\", \"in_flight\"].forEach(k => pm.expect(h, k).to.have.property(k));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Registry lists every service",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const services = pm.response.json().services;",
                  "const byName = {};",
                  "services.forEach(s => byName[s.name] = s.instances);",
                  "const business = [\"user-management-service\", \"battle-service\", \"tamagotchi-service\", \"notification-service\", \"map-service\", \"monster-raid-service\", \"guild-service\", \"package-registry-service\"];",
                  "",
                  "pm.test(\"The gateway is registered\", () => pm.expect(byName[\"api-gateway\"]).to.have.length.of.at.least(1));",
                  "business.forEach(name => {",
                  "  const list = byName[name] || [];",
                  "  pm.test(`${name}: at least 2 replicas registered`, () => pm.expect(list).to.have.length.of.at.least(2));",
                  "  pm.test(`${name}: every replica has its own instance_id`, () =>",
                  "    pm.expect(new Set(list.map(i => i.instance_id)).size).to.eql(list.length));",
                  "});",
                  "",
                  "// Saved for the routing checks: service -> [instance_id]",
                  "const snapshot = {};",
                  "Object.keys(byName).forEach(n => snapshot[n] = byName[n].map(i => i.instance_id));",
                  "pm.collectionVariables.set(\"registry_snapshot\", JSON.stringify(snapshot));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{registry_url}}/api/registry/services",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Every instance reports its health (polled by Service Discovery)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const instances = pm.response.json().services.flatMap(s => s.instances.map(i => ({ service: s.name, ...i })));",
                  "const checked = instances.filter(i => i.health);",
                  "pm.test(\"The health poller has checked the instances\", () => pm.expect(checked.length).to.be.above(0));",
                  "checked.forEach(i => {",
                  "  pm.test(`${i.service} ${i.instance_id}: healthy, load below critical`, () => {",
                  "    pm.expect(i.health.condition, i.health.error || \"\").to.eql(\"ok\");",
                  "    pm.expect(i.health.load).to.be.below(0.95);",
                  "    pm.expect(i.health.max_concurrent).to.be.above(0);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{registry_url}}/api/registry/services",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
