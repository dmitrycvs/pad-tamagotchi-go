{
  "info": {
    "_postman_id": "7365662a-e392-5c3d-857a-6cbe8dd36e5b",
    "name": "Tamagotchi Go — Lab 3 Scaling Check",
    "description": "Checks the Lab 3 grade points against the running Compose stack: health endpoints, registration, the registry API, routing through Service Discovery, round-robin, realtime routing, the circuit breaker removing a failing instance, and heartbeat expiry. Run the whole collection with the Collection Runner (about 1 minute). No environment or secrets needed; it signs up its own test user. Circuit-breaker trips are also logged: docker compose logs | grep \"Circuit breaker\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Shared helpers for the Lab 3 checks. Each takes the calling script's pm (and",
          "// postman), because objects captured here belong to this collection-level script.",
          "lab3 = {",
          "  // Registry snapshot saved by \"Registry lists every service\".",
          "  instancesOf(pm, service) {",
          "    const snapshot = JSON.parse(pm.collectionVariables.get(\"registry_snapshot\") || \"{}\");",
          "    return snapshot[service] || [];",
          "  },",
          "  // The gateway names the instance that served a request in X-Upstream-Instance.",
          "  upstream(pm) {",
          "    return pm.response.headers.get(\"X-Upstream-Instance\");",
          "  },",
          "  // Runs the current request again (Collection Runner / newman only).",
          "  repeat(pm, postman) {",
          "    if (pm.execution && typeof pm.execution.setNextRequest === \"function\") pm.execution.setNextRequest(pm.info.requestName);",
          "    else postman.setNextRequest(pm.info.requestName);",
          "  },",
          "  expectServedBy(pm, service) {",
          "    const id = lab3.upstream(pm);",
          "    pm.test(`Served by a registered ${service} instance (X-Upstream-Instance)`, () => {",
          "      pm.expect(id, \"X-Upstream-Instance header\").to.be.a(\"string\").and.not.empty;",
          "      pm.expect(lab3.instancesOf(pm, service), `instances of ${service}`).to.include(id);",
          "    });",
          "  }",
          "};"
        ]
      }
    }
  ],
