{
	"info": {
		"_postman_id": "c534ca9e-80fa-43c1-99c2-e6b8722f6cf6",
		"name": "Tamagotchi Go — API Gateway",
		"description": "Gateway routing, authorization, WebSocket negotiation and error handling. Routed requests reach the real services, so run them against the full compose stack. The 401/403/404 checks are answered by the gateway itself and need no other service.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Generates the JWTs this collection needs, signed with the stack secrets.",
					"// Set jwt_secret / service_jwt_secret to the values in your .env.",
					"const TOKENS = {\"jwt\":{\"sub\":\"user_id\"},\"admin_jwt\":{\"sub\":\"user_id\",\"roles\":[\"user\",\"admin\"]},\"service_jwt\":{\"service\":true}};",
					"const DEFAULT_PACKAGE = 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';",
					"const v = (k) => pm.variables.get(k) || \"\";",
      "// Select a local Postman environment with the signing secrets from .env.",
      "for (const key of [\"jwt_secret\", \"service_jwt_secret\"]) {",
      "  if (v(key).length < 32) {",
      "    throw new Error(\"Select the local Tamagotchi environment: \" + key + \" must match .env and contain at least 32 characters.\");",
      "  }",
      "}",
					"const b64url = (w) => CryptoJS.enc.Base64.stringify(w).split(\"=\").join(\"\").split(\"+\").join(\"-\").split(\"/\").join(\"_\");",
					"const enc = (o) => b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(o)));",
					"const sign = (claims, secret) => {",
					"  const body = enc({ alg: \"HS256\", typ: \"JWT\" }) + \".\" + enc(claims);",
					"  return body + \".\" + b64url(CryptoJS.HmacSHA256(body, secret));",
					"};",
					"const now = Math.floor(Date.now() / 1000);",
					"Object.entries(TOKENS).forEach(([name, t]) => {",
					"  const claims = t.service",
					"    ? { sub: \"postman\", roles: [\"service\"] }",
					"    : { sub: t.subValue || v(t.sub), package_id: v(\"package_id\") || DEFAULT_PACKAGE, roles: t.roles || [\"user\"] };",
					"  claims.iat = now;",
					"  claims.exp = now + 3600;",
					"  pm.collectionVariables.set(name, sign(claims, v(t.service ? \"service_jwt_secret\" : \"jwt_secret\")));",
					"});"
				]
			}
		}
	],
