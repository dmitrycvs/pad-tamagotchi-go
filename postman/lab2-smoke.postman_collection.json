              "  const body = pm.response.json();",
              "  pm.test(\"Direct WebSocket URL returned\", () => pm.expect(body.url).to.match(/^wss?:\\/\\//));",
              "  pm.collectionVariables.set(\"guild_ws_url\", body.url);",
              "}"
