{
  "info": {
    "_postman_id": "12cb84d0-aa3b-49ae-ad01-b85c4acd6944",
    "name": "Tamagotchi Go — Notification Service",
    "description": "Notification Service collection based on the provided route list and shared Communication Contract. Register Device and Publish Event save device_id and notification_id. User operations use jwt; publish and delivery status use service_jwt.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Reference",
      "item": [
        {
          "name": "Health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));", "pm.test(\"Response is JSON\", () => pm.response.to.be.json);"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] },
            "description": "Health endpoint supplied by the service owner. Only status and JSON are asserted because the private implementation is unavailable."
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"service\": \"notification-service\",\n  \"status\": \"ok\"\n}" }]
        },
        {
          "name": "Get Notification Types",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));", "pm.test(\"Response is JSON\", () => pm.response.to.be.json);"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/notifications/types", "host": ["{{base_url}}"], "path": ["api", "notifications", "types"] },
            "description": "Type-list endpoint supplied by the service owner. The private implementation is unavailable, so only status and JSON are asserted."
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"types\": [\n    {\n      \"published_by\": \"User Management Service\",\n      \"type\": \"friend_request_received\"\n    },\n    {\n      \"published_by\": \"Map Service\",\n      \"type\": \"nearby_player_detected\"\n    },\n    {\n      \"published_by\": \"Battle Service\",\n      \"type\": \"battle_request_received\"\n    },\n    {\n      \"published_by\": \"Battle Service\",\n      \"type\": \"tamagotchi_captured\"\n    },\n    {\n      \"published_by\": \"Guild Service\",\n      \"type\": \"guild_invitation\"\n    },\n    {\n      \"published_by\": \"Monster Raid Service\",\n      \"type\": \"raid_started\"\n    }\n  ]\n}" }]
        }
      ]
    },
    {
      "name": "Devices",
      "item": [
        {
          "name": "Register a Device Token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.expect(body.device_id).to.be.a(\"string\").and.not.empty;", "pm.collectionVariables.set(\"device_id\", body.device_id);"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"fcm_token\": \"{{fcm_token}}\",\n  \"platform\": \"android\",\n  \"package_id\": \"{{package_id}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/notifications/devices", "host": ["{{base_url}}"], "path": ["api", "notifications", "devices"] }
          },
          "response": [
            { "name": "201 Created", "status": "Created", "code": 201, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"device_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"registered_at\": \"2026-09-24T12:00:00Z\"\n}" },
            { "name": "401 Unauthorized", "status": "Unauthorized", "code": 401, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"error\": \"Unauthorized.\"\n}" }
          ]
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Publish an Event",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 202 Accepted\", () => pm.response.to.have.status(202));", "const body = pm.response.json();", "pm.expect(body.notification_id).to.be.a(\"string\").and.not.empty;", "pm.collectionVariables.set(\"notification_id\", body.notification_id);"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{service_jwt}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"event_id\": \"{{$guid}}\",\n  \"recipient_id\": \"{{user_id}}\",\n  \"type\": \"battle_request_received\",\n  \"title\": \"Battle request\",\n  \"body\": \"A trainer wants to battle!\",\n  \"data\": {\n    \"battle_id\": \"{{battle_id}}\",\n    \"challenger_id\": \"{{challenger_id}}\"\n  }\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/notifications/publish", "host": ["{{base_url}}"], "path": ["api", "notifications", "publish"] },
            "description": "Internal idempotent endpoint; requires service_jwt."
          },
          "response": [{ "name": "202 Accepted", "status": "Accepted", "code": 202, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"notification_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n  \"status\": \"queued\",\n  \"devices_targeted\": 1\n}" }]
        },
        {
          "name": "List a User's Notifications",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().notifications).to.be.an(\"array\");"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/notifications?user_id={{user_id}}&unread_only=true", "host": ["{{base_url}}"], "path": ["api", "notifications"], "query": [{ "key": "user_id", "value": "{{user_id}}" }, { "key": "unread_only", "value": "true" }] }
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"user_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"notifications\": [\n    {\n      \"notification_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n      \"type\": \"battle_request_received\",\n      \"title\": \"Battle request\",\n      \"body\": \"A trainer wants to battle!\",\n      \"data\": { \"battle_id\": \"cccccccc-cccc-4ccc-8ccc-cccccccccccc\" },\n      \"read\": false,\n      \"created_at\": \"2026-09-24T12:05:00Z\"\n    }\n  ]\n}" }]
        },
        {
          "name": "Mark as Read",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Request succeeds\", () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"read\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/notifications/{{notification_id}}", "host": ["{{base_url}}"], "path": ["api", "notifications", "{{notification_id}}"] }
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"notification_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n  \"read\": true\n}" }]
        },
        {
          "name": "Get Delivery Status",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.have.property(\"status\");"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{service_jwt}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/notifications/{{notification_id}}/status", "host": ["{{base_url}}"], "path": ["api", "notifications", "{{notification_id}}", "status"] },
            "description": "Internal endpoint; requires service_jwt."
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"notification_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n  \"status\": \"delivered\",\n  \"attempts\": 1,\n  \"deliveries\": [\n    {\n      \"device_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n      \"status\": \"delivered\",\n      \"at\": \"2026-09-24T12:05:01Z\"\n    }\n  ]\n}" }]
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Unregister a Device",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 204 No Content\", () => pm.response.to.have.status(204));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/api/notifications/devices/{{device_id}}", "host": ["{{base_url}}"], "path": ["api", "notifications", "devices", "{{device_id}}"] },
            "description": "Run after notification delivery checks."
          },
          "response": [{ "name": "204 No Content", "status": "No Content", "code": 204, "header": [], "cookie": [], "body": "" }]
        }
      ]
    }
  ],
  "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
      "// Generates the JWTs this collection needs, signed with the stack secrets.",
      "// Set jwt_secret / service_jwt_secret to the values in your .env.",
      "const TOKENS = {\"jwt\":{\"sub\":\"user_id\"},\"service_jwt\":{\"service\":true}};",
      "const DEFAULT_PACKAGE = 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';",
      "const v = (k) => pm.variables.get(k) || \"\";",
      "const b64url = (w) => CryptoJS.enc.Base64.stringify(w).split(\"=\").join(\"\").split(\"+\").join(\"-\").split(\"/\").join(\"_\");",
      "const enc = (o) => b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(o)));",
      "const sign = (claims, secret) => {",
      "  const body = enc({ alg: \"HS256\", typ: \"JWT\" }) + \".\" + enc(claims);",
      "  return body + \".\" + b64url(CryptoJS.HmacSHA256(body, secret));",
      "};",
      "const now = Math.floor(Date.now() / 1000);",
      "Object.entries(TOKENS).forEach(([name, t]) => {",
      "  const claims = t.service",
      "    ? { sub: \"postman\", roles: [\"service\"] }",
      "    : { sub: t.subValue || v(t.sub), package_id: v(\"package_id\") || DEFAULT_PACKAGE, roles: t.roles || [\"user\"] };",
      "  claims.iat = now;",
      "  claims.exp = now + 3600;",
      "  pm.collectionVariables.set(name, sign(claims, v(t.service ? \"service_jwt_secret\" : \"jwt_secret\")));",
      "});"
    ] } }],
  "variable": [
    { "key": "jwt_secret", "value": "change_me_to_a_secret_with_at_least_32_characters", "type": "string", "description": "Must equal JWT_SECRET in the stack .env; used to sign user tokens." },
    { "key": "service_jwt_secret", "value": "change_me_to_a_service_secret_at_least_32_chars", "type": "string", "description": "Must equal SERVICE_JWT_SECRET in the stack .env; used to sign service tokens." },
    { "key": "base_url", "value": "http://localhost:8084", "type": "string" },
    { "key": "jwt", "value": "", "type": "string", "description": "JWT for user_id; keep empty in the exported collection." },
    { "key": "service_jwt", "value": "", "type": "string", "description": "Keep empty in the exported collection." },
    { "key": "user_id", "value": "11111111-1111-4111-8111-111111111111", "type": "string" },
    { "key": "package_id", "value": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa", "type": "string" },
    { "key": "fcm_token", "value": "postman-local-fcm-token", "type": "string", "description": "Replace locally if the implementation validates or sends through Firebase." },
    { "key": "device_id", "value": "", "type": "string", "description": "Filled by Register a Device Token." },
    { "key": "notification_id", "value": "", "type": "string", "description": "Filled by Publish an Event." },
    { "key": "battle_id", "value": "cccccccc-cccc-4ccc-8ccc-cccccccccccc", "type": "string" },
    { "key": "challenger_id", "value": "22222222-2222-4222-8222-222222222222", "type": "string" }
  ]
}
