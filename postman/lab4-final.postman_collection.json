    {
      "name": "6. Load-based routing and failover (Grade 10)",
      "description": "Each message goes to the least-loaded instance; ties take turns. Failover needs a stopped replica; see the README, step 4.",
      "item": [
        {
          "name": "19 Requests spread over both replicas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const seen = new Set([pm.response.headers.get('X-Upstream-Instance')]);",
                  "let left = 5;",
                  "for (let n = 0; n < 5; n++) {",
                  "  pm.sendRequest(pm.variables.get('base_url') + '/api/tamagotchis/types', (err, res) => {",
                  "    if (!err) seen.add(res.headers.get('X-Upstream-Instance'));",
                  "    if (--left === 0) pm.test('6 requests reached 2 different instances', () => pm.expect(seen.size).to.be.at.least(2));",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/tamagotchis/types",
            "auth": {
              "type": "noauth"
            }
          },
