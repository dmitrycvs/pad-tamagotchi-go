    {
      "name": "5. Durable queues and dead letters (Grade 9)",
      "description": "Every message is stored in the message_broker database before it is sent. One that cannot be delivered goes to the dead letter channel, where it can be listed and retried.",
      "item": [
        {
          "name": "15 Publish an event the subscriber rejects",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted: the copy was stored', () => pm.response.to.have.status(202));",
                  "pm.test('Rejected with 400, so it is dead-lettered at once', () => pm.expect(pm.response.json().dead_lettered).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{broker_url}}/api/topics/tamagotchi.captured/events",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{service_jwt}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"postman-dead-{{run_id}}\",\n  \"payload\": {\n    \"title\": \"No recipient\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Notification answers 400 (payload.recipient_id is required). A 4xx cannot succeed later, so the broker skips the retries."
          },
          "response": []
        },
        {
          "name": "16 List dead letters",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 from the durable store', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().durable).to.eql(true);",
                  "});",
                  "const dead = pm.response.json().dead_letters.find((d) => d.event_id === 'postman-dead-' + pm.variables.get('run_id'));",
                  "pm.test('Our event is in the dead letter channel', () => {",
                  "  pm.expect(dead).to.be.an('object');",
                  "  pm.expect(dead.last_status).to.eql(400);",
