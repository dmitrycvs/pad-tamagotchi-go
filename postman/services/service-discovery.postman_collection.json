          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404: the instance must register again\", () => pm.response.to.have.status(404));",
              "pm.test(\"Error body\", () => pm.expect(pm.response.json().error).to.eql(\"Instance 'does-not-exist' is not registered.\"));"
            ]
