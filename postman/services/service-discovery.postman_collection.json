    },
    {
      "name": "Invalid registration (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error lists every invalid field\", () => {",
              "  const error = pm.response.json().error;",
              "  [\"service_name\", \"port\", \"health_path\"].forEach(f => pm.expect(error).to.include(f));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
