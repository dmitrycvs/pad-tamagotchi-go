          ]
        },
        {
          "name": "Guild Chat WebSocket",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ws_base_url}}/ws/guilds/{{guild_id}}?token={{jwt}}",
              "host": ["{{ws_base_url}}"],
              "path": ["ws", "guilds", "{{guild_id}}"],
              "query": [
                { "key": "token", "value": "{{jwt}}" }
              ]
            },
            "description": "Open this URL as a WebSocket request in the Postman desktop client. Send {\"type\":\"send_message\",\"content\":\"who is joining the raid?\"} or {\"type\":\"typing\"}. Collection runners treat this exported entry as documentation and do not execute a persistent WebSocket session."
          },
          "response": []
        }
