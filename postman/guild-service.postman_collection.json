                  "});",
                  "pm.test(\"User is a guild member\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.is_member).to.eql(true);",
                  "    pm.expect(body.role).to.eql(\"officer\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{service_jwt}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/guilds/{{guild_id}}/members/{{member_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "guilds", "{{guild_id}}", "members", "{{member_id}}"]
            },
            "description": "Internal endpoint. Requires a token signed with SERVICE_JWT_SECRET."
          },
          "response": [
