          "name": "06 Every service registers gRPC and two replicas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const services = [\"user-management-service\", \"battle-service\", \"tamagotchi-service\", \"notification-service\", \"map-service\", \"monster-raid-service\", \"guild-service\", \"package-registry-service\"];",
                  "const topics = [\"battle.request_received\", \"guild.invitation_sent\", \"map.nearby_player_detected\", \"raid.started\", \"tamagotchi.captured\", \"user.friend_request_received\"];",
                  "pm.test('Notification subscribes to the six notification topics', () => {",
                  "  for (const i of pm.response.json().instances) pm.expect(i.topics).to.include.members(topics);",
                  "});",
                  "for (const service of services) {",
                  "  pm.sendRequest(pm.variables.get('registry_url') + '/api/registry/services/' + service + '/instances', (err, res) => {",
                  "    pm.test(service + ': at least 2 replicas, each with grpc_port 9000', () => {",
                  "      pm.expect(err).to.eql(null);",
                  "      const instances = res.json().instances;",
                  "      pm.expect(instances.length).to.be.at.least(2);",
                  "      for (const i of instances) pm.expect(i.grpc_port).to.eql(9000);",
                  "    });",
                  "  });",
                  "}"
                ]
