          "mode": "raw",
          "raw": "{\n  \"service_name\": \"\",\n  \"instance_id\": \"x\",\n  \"host\": \"h\",\n  \"port\": 0,\n  \"health_path\": \"health\"\n}",
          "options": {
            "raw": {
              "language": "json"
