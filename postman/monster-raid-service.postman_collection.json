{
  "info": {
    "_postman_id": "a61dfb67-e7dc-4009-8b0a-3a7cbef90bb2",
    "name": "Tamagotchi Go — Monster Raid Service",
    "description": "Requests for the Monster Raid Service communication contract. Includes health check, raid scheduling (admin), listing active raids, raid details, joining, dealing damage, and leaderboard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Public health check endpoint."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"status\": \"ok\"\n}"
        }
      ]
    },
    {
      "name": "Schedule a Raid",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "if (body.raid_id) {",
              "    pm.collectionVariables.set(\"raid_id\", body.raid_id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{admin_jwt}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"monster_id\": \"{{monster_id}}\",\n  \"guild_id\": \"{{guild_id}}\",\n  \"starts_at\": \"{{$isoTimestamp}}\",\n  \"duration_seconds\": 3600,\n  \"participant_limit\": 30\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/raids",
          "host": ["{{base_url}}"],
          "path": ["api", "raids"]
        },
        "description": "Admin-only. Schedules a new raid using a monster definition. Sets raid_id collection variable."
      },
      "response": [
        {
          "name": "201 Created",
          "status": "Created",
          "code": 201,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"raid_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"status\": \"scheduled\"\n}"
        },
        {
          "name": "401 Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"error\": \"Unauthorized.\"\n}"
        },
        {
          "name": "403 Forbidden",
          "status": "Forbidden",
          "code": 403,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"error\": \"Admin role required.\"\n}"
        }
      ]
    },
    {
      "name": "List Active Raids",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is an array\", () => {",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/raids?guild_id={{guild_id}}&status=active",
          "host": ["{{base_url}}"],
          "path": ["api", "raids"],
          "query": [
            { "key": "guild_id", "value": "{{guild_id}}" },
            { "key": "status", "value": "active" }
          ]
        },
        "description": "Lists active raids for a guild. Requires user JWT."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "[\n  {\n    \"raid_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n    \"monster_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n    \"monster_name\": \"The Deadline\",\n    \"current_hp\": 184000,\n    \"max_hp\": 500000,\n    \"status\": \"active\",\n    \"participants\": 14,\n    \"participant_limit\": 30,\n    \"started_at\": \"2026-09-09T12:00:00Z\",\n    \"expires_at\": \"2026-09-09T13:00:00Z\"\n  }\n]"
        }
      ]
    },
    {
      "name": "Get Raid Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response contains monster details\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"monster\");",
              "    pm.expect(body).to.have.property(\"current_hp\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/raids/{{raid_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "raids", "{{raid_id}}"]
        },
        "description": "Returns full details of a specific raid including monster stats and participants."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"raid_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"monster\": {\n    \"monster_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n    \"name\": \"The Deadline\",\n    \"sprite_ref\": \"global/sprites/deadline.png\",\n    \"max_hp\": 500000,\n    \"weaknesses\": [\"flame\"],\n    \"resistances\": [\"shadow\"]\n  },\n  \"current_hp\": 184000,\n  \"status\": \"active\",\n  \"guild_id\": \"cccccccc-cccc-4ccc-8ccc-cccccccccccc\",\n  \"expires_at\": \"2026-09-09T13:00:00Z\",\n  \"participants\": [\n    { \"user_id\": \"11111111-1111-4111-8111-111111111111\", \"tamagotchi_id\": \"11111111-aaaa-4aaa-8aaa-111111111111\", \"damage_dealt\": 24500 }\n  ]\n}"
        }
      ]
    },
    {
      "name": "Join a Raid",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Joined successfully\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"damage_per_hit\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"tamagotchi_id\": \"{{tamagotchi_id}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/raids/{{raid_id}}/join",
          "host": ["{{base_url}}"],
          "path": ["api", "raids", "{{raid_id}}", "join"]
        },
        "description": "Joins the raid with a Tamagotchi. Verifies guild membership with Guild Service."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"raid_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"user_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"joined_at\": \"2026-09-09T12:31:00Z\",\n  \"damage_per_hit\": 340\n}"
        },
        {
          "name": "403 Forbidden (not in guild)",
          "status": "Forbidden",
          "code": 403,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"error\": \"User is not a member of the guild hosting this raid.\"\n}"
        },
        {
          "name": "409 Conflict (raid full or expired)",
          "status": "Conflict",
          "code": 409,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"error\": \"Raid is full or no longer active.\"\n}"
        }
      ]
    },
    {
      "name": "Deal Damage",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Damage response valid\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"damage_applied\");",
              "    pm.expect(body).to.have.property(\"current_hp\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"{{$guid}}\",\n  \"user_id\": \"{{user_id}}\",\n  \"hits\": 5\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/raids/{{raid_id}}/damage",
          "host": ["{{base_url}}"],
          "path": ["api", "raids", "{{raid_id}}", "damage"]
        },
        "description": "Applies clicker damage. Idempotent via event_id."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"raid_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"damage_applied\": 1700,\n  \"current_hp\": 182300,\n  \"total_damage_dealt\": 26200,\n  \"monster_defeated\": false\n}"
        }
      ]
    },
    {
      "name": "Get Raid Leaderboard",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Leaderboard list returned\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"leaderboard\");",
              "    pm.expect(body.leaderboard).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/raids/{{raid_id}}/leaderboard",
          "host": ["{{base_url}}"],
          "path": ["api", "raids", "{{raid_id}}", "leaderboard"]
        },
        "description": "Retrieves the damage leaderboard for this raid."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"raid_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"leaderboard\": [\n    { \"rank\": 1, \"user_id\": \"11111111-1111-4111-8111-111111111111\", \"username\": \"dima_trainer\", \"damage_dealt\": 26200 },\n    { \"rank\": 2, \"user_id\": \"22222222-2222-4222-8222-222222222222\", \"username\": \"kiki\", \"damage_dealt\": 19800 }\n  ]\n}"
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8086", "type": "string" },
    { "key": "jwt", "value": "", "type": "string", "description": "User JWT; keep empty in exported collection." },
    { "key": "admin_jwt", "value": "", "type": "string", "description": "Admin user JWT; keep empty in exported collection." },
    { "key": "user_id", "value": "11111111-1111-4111-8111-111111111111", "type": "string" },
    { "key": "guild_id", "value": "cccccccc-cccc-4ccc-8ccc-cccccccccccc", "type": "string" },
    { "key": "monster_id", "value": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb", "type": "string" },
    { "key": "tamagotchi_id", "value": "11111111-aaaa-4aaa-8aaa-111111111111", "type": "string" },
    { "key": "raid_id", "value": "", "type": "string", "description": "Set automatically by Schedule a Raid." }
  ]
}
