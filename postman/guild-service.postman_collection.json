    {
      "name": "Chat",
      "item": [
        {
          "name": "Get Chat History",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Messages is an array\", function () {",
                  "    pm.expect(pm.response.json().messages).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{jwt}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/guilds/{{guild_id}}/messages?limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "guilds", "{{guild_id}}", "messages"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "before", "value": "{{message_id}}", "disabled": true }
              ]
