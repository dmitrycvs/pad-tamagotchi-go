# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.
#
#   cp .env.example .env

# --- Database ---------------------------------------------------------------
POSTGRES_USER=tamagotchi
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- Secrets ----------------------------------------------------------------
# JWT_SECRET signs user tokens issued by the User Management Service.
# SERVICE_JWT_SECRET signs service-to-service tokens; every service must share it.
# NOTE: Must be at least 32 characters (256 bits) for HMAC-SHA256 (.NET services enforce this).
JWT_SECRET=change_me_to_a_secret_with_at_least_32_characters
SERVICE_JWT_SECRET=change_me_to_a_service_secret_at_least_32_chars

# --- Firebase (Notification Service) ----------------------------------------
# FIREBASE_CREDENTIALS_JSON holds the service-account JSON as a single line.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# --- Map Service ------------------------------------------------------------
PROXIMITY_THRESHOLD_METERS=6

# --- DockerHub namespaces ---------------------------------------------------
# The DockerHub account each teammate publishes their images under.
DOCKERHUB_USER_DMITRII=dmitrycvs
DOCKERHUB_USER_MAXIM=maxkostov
DOCKERHUB_USER_DENIS=takima
DOCKERHUB_USER_FILIP=filipel2004

# --- Image tags -------------------------------------------------------------
# Override to pin a specific version; defaults to 1.0.0 when unset.
TAG_USER_MANAGEMENT=1.0.0
TAG_BATTLE=1.0.0
TAG_TAMAGOTCHI=1.0.0
TAG_NOTIFICATION=1.0.0
TAG_MAP=1.0.0
TAG_MONSTER_RAID=1.0.0
TAG_GUILD=1.0.0
TAG_PACKAGE_REGISTRY=1.0.0
