{
  "info": {
    "_postman_id": "c76decb2-691c-4cf6-bef7-d447a0014ac7",
    "name": "Tamagotchi Go — Guild Service",
    "description": "Requests for the Guild Service communication contract. Run the REST requests in collection order. The create and invitation requests save generated IDs for subsequent requests. Configure JWT values in a local Postman environment; exported token values are intentionally empty.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Guilds",
      "item": [
        {
          "name": "Create a Guild",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Response contains a guild ID\", function () {",
                  "    pm.expect(body.guild_id).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"guild_id\", body.guild_id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{jwt}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Guild {{$timestamp}}\",\n  \"description\": \"Guild created by the Postman collection\",\n  \"owner_id\": \"{{owner_id}}\",\n  \"event_id\": \"{{$guid}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/guilds",
              "host": ["{{base_url}}"],
              "path": ["api", "guilds"]
            },
            "description": "Creates a guild. The JWT subject must equal owner_id. Saves guild_id for the remaining requests."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"guild_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"name\": \"Postman Guild 1700000000\",\n  \"owner_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"member_count\": 1,\n  \"created_at\": \"2026-09-24T12:00:00Z\"\n}"
            },
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"error\": \"Authorization bearer token required.\"\n}"
            },
            {
              "name": "403 Owner mismatch",
              "status": "Forbidden",
              "code": 403,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"error\": \"owner_id must match the token subject.\"\n}"
            },
            {
              "name": "409 Duplicate guild",
              "status": "Conflict",
              "code": 409,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"error\": \"Resource already exists.\"\n}"
            }
          ]
        },
        {
          "name": "Get a Guild",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response matches the current guild\", function () {",
                  "    pm.expect(pm.response.json().guild_id).to.eql(pm.collectionVariables.get(\"guild_id\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{jwt}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/guilds/{{guild_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "guilds", "{{guild_id}}"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"guild_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"name\": \"Postman Guild\",\n  \"description\": \"Guild created by the Postman collection\",\n  \"owner_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"members\": [\n    {\n      \"user_id\": \"11111111-1111-4111-8111-111111111111\",\n      \"username\": \"user_11111111\",\n      \"role\": \"owner\"\n    }\n  ]\n}"
            },
            {
              "name": "404 Guild not found",
              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"error\": \"Resource not found.\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Invitations",
      "item": [
        {
          "name": "Invite a User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 202 Accepted\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Invitation is pending\", function () {",
                  "    pm.expect(body.status).to.eql(\"pending\");",
                  "});",
                  "pm.collectionVariables.set(\"invitation_id\", body.invitation_id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{jwt}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_user_id\": \"{{member_id}}\",\n  \"event_id\": \"{{$guid}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/guilds/{{guild_id}}/invitations",
              "host": ["{{base_url}}"],
              "path": ["api", "guilds", "{{guild_id}}", "invitations"]
            }
          },
          "response": [
            {
              "name": "202 Accepted",
              "status": "Accepted",
              "code": 202,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"invitation_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n  \"status\": \"pending\"\n}"
            },
            {
              "name": "403 Insufficient guild role",
              "status": "Forbidden",
              "code": 403,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"error\": \"Owner or officer role required.\"\n}"
            },
            {
              "name": "409 Invitation already pending",
              "status": "Conflict",
              "code": 409,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"error\": \"Invitation already pending.\"\n}"
            }
          ]
        },
        {
          "name": "Respond to an Invitation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Invitation was accepted\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql(\"accepted\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{member_jwt}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"accept\",\n  \"event_id\": \"{{$guid}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/guilds/{{guild_id}}/invitations/{{invitation_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "guilds", "{{guild_id}}", "invitations", "{{invitation_id}}"]
            }
          },
          "response": [
            {
              "name": "200 Accepted invitation",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"invitation_id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n  \"status\": \"accepted\"\n}"
            },
            {
              "name": "403 Invitation belongs to another user",
              "status": "Forbidden",
              "code": 403,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"error\": \"Invitation belongs to another user.\"\n}"
            },
            {
              "name": "409 Invitation already answered",
              "status": "Conflict",
              "code": 409,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"error\": \"Invitation already answered.\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Members",
      "item": [
