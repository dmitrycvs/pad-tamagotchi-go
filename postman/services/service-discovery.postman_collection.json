        "url": {
          "raw": "{{registry_url}}/api/registry/instances",
          "host": [
            "{{registry_url}}"
          ],
          "path": [
            "api",
            "registry",
            "instances"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"service_name\": \"postman-probe\",\n  \"instance_id\": \"{{probe_id}}\",\n  \"host\": \"{{probe_id}}.invalid\",\n  \"port\": 8080\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Heartbeat (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"last_heartbeat_at moved forward\", () => {",
              "  const i = pm.response.json();",
              "  pm.expect(new Date(i.last_heartbeat_at) >= new Date(i.registered_at)).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{registry_url}}/api/registry/instances/{{probe_id}}/heartbeat",
          "host": [
            "{{registry_url}}"
          ],
          "path": [
            "api",
            "registry",
            "instances",
            "{{probe_id}}",
            "heartbeat"
          ]
        }
      }
    },
    {
      "name": "Instances of the registered service (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"The probe is listed\", () =>",
              "  pm.expect(pm.response.json().instances.map(i => i.instance_id)).to.include(pm.collectionVariables.get(\"probe_id\")));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
