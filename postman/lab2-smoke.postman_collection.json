{
  "info": {
    "_postman_id": "4e888c83-fc3e-431b-a73b-083fbfb674a2",
    "name": "Tamagotchi Go — Lab 2 Smoke Test",
    "description": "Run all requests in order with the Collection Runner against the published Compose stack. Registers one test user and creates one guild. Uses the real JWT from User Management; no signing secrets or Postman environment are required. Route probes for Package Registry and Battle intentionally return 404 for nonexistent IDs. Full battle, raid participation and Firebase push delivery need separate scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Gateway health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Gateway healthy\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "response": []
    },
    {
      "name": "02 Register test user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString() + Math.floor(Math.random() * 10000).toString();",
              "pm.collectionVariables.set(\"run_id\", suffix);",
              "pm.collectionVariables.set(\"run_username\", \"lab2_\" + suffix);",
              "pm.collectionVariables.set(\"run_email\", \"lab2_\" + suffix + \"@example.invalid\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.test(\"User ID returned\", () => pm.expect(body.user_id).to.be.a(\"string\").and.not.empty);",
              "  pm.collectionVariables.set(\"user_id\", body.user_id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{run_username}}\",\n  \"email\": \"{{run_email}}\",\n  \"password\": \"{{run_password}}\",\n  \"package_id\": \"{{package_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Creates a unique test account on every collection run."
      },
      "response": []
    },
    {
      "name": "03 Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"JWT returned\", () => pm.expect(body.jwt).to.be.a(\"string\").and.not.empty);",
              "  pm.collectionVariables.set(\"jwt\", body.jwt);",
              "  pm.collectionVariables.set(\"user_id\", body.user_id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{run_email}}\",\n  \"password\": \"{{run_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "04 Gateway identity",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Correct identity\", () => {",
              "    pm.expect(body.type).to.eql(\"user\");",
              "    pm.expect(body.sub).to.eql(pm.collectionVariables.get(\"user_id\"));",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt}}",
              "type": "string"
            }
