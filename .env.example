# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.
#
#   cp .env.example .env

# --- Database ---------------------------------------------------------------
POSTGRES_USER=tamagotchi
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- Secrets ----------------------------------------------------------------
# JWT_SECRET signs user tokens issued by the User Management Service.
# SERVICE_JWT_SECRET signs service-to-service tokens; every service must share it.
# NOTE: Must be at least 32 characters (256 bits) for HMAC-SHA256 (.NET services enforce this).
JWT_SECRET=change_me_to_a_secret_with_at_least_32_characters
SERVICE_JWT_SECRET=change_me_to_a_service_secret_at_least_32_chars

# --- Firebase (Notification Service) ----------------------------------------
# FIREBASE_CREDENTIALS_JSON holds the service-account JSON as a single line.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# --- API Gateway ------------------------------------------------------------
# Lab 2: the gateway validates JWTs and does NOT forward the Authorization header.
# Set to true only as a temporary bridge while a service still validates JWTs itself.
GATEWAY_FORWARD_AUTHORIZATION=false
# Required. Must match across the gateway and services for REST identity headers.
GATEWAY_SHARED_SECRET=change_me_to_a_random_gateway_secret
# Task timeout and concurrent task limit (exceeded -> 504 / 503).
GATEWAY_REQUEST_TIMEOUT=10s
GATEWAY_MAX_CONCURRENT_REQUESTS=200
# Public WebSocket base URLs handed to clients by POST /api/realtime/...
# Each points at the first port of the service's host port range (one port per replica).
WS_PUBLIC_URL_BATTLE=ws://localhost:8082
WS_PUBLIC_URL_MAP=ws://localhost:8085
WS_PUBLIC_URL_MONSTER_RAID=ws://localhost:8088
WS_PUBLIC_URL_GUILD=ws://localhost:8091
# When discovery is enabled, map actual instance IDs to their published ports.
# Generate with: python3 scripts/realtime-instance-urls.py
WS_PUBLIC_INSTANCE_URLS={}

# Guild replicas share this event channel; history and outbox stay in PostgreSQL.
REDIS_URL=redis://redis:6379/0
GUILD_REDIS_CHANNEL=tamagotchi:guild:events

# --- Service task limits ----------------------------------------------------
# Per-service task timeout in seconds; keep it below GATEWAY_REQUEST_TIMEOUT so the
# service's own 504 reaches the client first. Exceeded -> 504.
REQUEST_TIMEOUT_SECONDS=8
# Per-service concurrent task limit. Exceeded -> 503 with Retry-After: 1.
MAX_CONCURRENT_REQUESTS=100

# --- Service Discovery ------------------------------------------------------
# Every service registers here on startup and the gateway routes to the registered
# instances. Leave as is inside Docker; empty disables registration and discovery routing.
SERVICE_DISCOVERY_URL=http://service-discovery:8761

# --- Replicas (Lab 3) -------------------------------------------------------
# Instances started per business service. Battle, Map, Monster Raid and Guild publish
# one host port per replica from a range of three, so keep those at 3 or fewer.
REPLICAS_USER_MANAGEMENT=2
REPLICAS_BATTLE=2
REPLICAS_TAMAGOTCHI=2
REPLICAS_NOTIFICATION=2
REPLICAS_MAP=2
REPLICAS_MONSTER_RAID=2
REPLICAS_GUILD=2
REPLICAS_PACKAGE_REGISTRY=2

# --- Map Service ------------------------------------------------------------
PROXIMITY_THRESHOLD_METERS=6

# --- DockerHub namespaces ---------------------------------------------------
# The DockerHub account each teammate publishes their images under.
DOCKERHUB_USER_DMITRII=dmitrycvs
DOCKERHUB_USER_MAXIM=maxkostov
DOCKERHUB_USER_DENIS=takima
DOCKERHUB_USER_FILIP=filipel2004

# --- Image tags -------------------------------------------------------------
# Override to pin a specific version; defaults match docker-compose.yml.
TAG_USER_MANAGEMENT=3.0.0
TAG_BATTLE=3.0.0
TAG_TAMAGOTCHI=2.2.0
TAG_NOTIFICATION=2.2.0
TAG_MAP=2.2.0
TAG_MONSTER_RAID=2.2.0
TAG_GUILD=3.0.0
TAG_PACKAGE_REGISTRY=3.0.0
TAG_GATEWAY=3.0.0
TAG_SERVICE_DISCOVERY=3.3.0

# --- Lab 3 alerts and circuit breakers --------------------------------------
# Secret: leave empty to disable Discord; never commit a real webhook URL.
DISCORD_WEBHOOK_URL=
DISCORD_MIN_INTERVAL=5s
DISCORD_TIMEOUT=3s
DISCORD_DEDUP_WINDOW=60s
DISCORD_QUEUE_CAPACITY=100
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# Go services: seconds; empty derives from REQUEST_TIMEOUT_SECONDS x 3.5.
CIRCUIT_BREAKER_WINDOW_SECONDS=
CIRCUIT_BREAKER_COOLDOWN_SECONDS=
# These versions must be published before the CPR release PR is merged.
