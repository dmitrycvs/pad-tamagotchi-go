{
  "info": {
    "_postman_id": "9a69e8a4-667a-480b-b752-b0b81db4dbcc",
    "name": "Tamagotchi Go — Battle Service",
    "description": "Battle Service collection based on the shared Communication Contract. Create Battle stores battle_id. Accept requires the opponent JWT; turns require the JWT of the current actor. Battle Result and Forfeit represent alternative end-of-battle flows and should not be run blindly in the same runner pass.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create a Battle",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.expect(body.battle_id).to.be.a(\"string\").and.not.empty;", "pm.collectionVariables.set(\"battle_id\", body.battle_id);"] } }],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"challenger_id\": \"{{challenger_id}}\",\n  \"opponent_id\": \"{{opponent_id}}\",\n  \"challenger_lineup\": {\n    \"primary_id\": \"{{challenger_primary_id}}\",\n    \"secondary_id\": \"{{challenger_secondary_id}}\",\n    \"boosts\": [\"boost-atk-01\"]\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/battles", "host": ["{{base_url}}"], "path": ["api", "battles"] }
      },
      "response": [
        { "name": "201 Created", "status": "Created", "code": 201, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"battle_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"status\": \"awaiting_opponent\",\n  \"created_at\": \"2026-09-24T12:00:00Z\"\n}" },
        { "name": "401 Unauthorized", "status": "Unauthorized", "code": 401, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"error\": \"Unauthorized.\"\n}" },
        { "name": "403 Opponent blocked challenger", "status": "Forbidden", "code": 403, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"error\": \"Opponent has blocked this user.\"\n}" }
      ]
    },
    {
      "name": "Accept a Battle",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql(\"in_progress\");"] } }],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{opponent_jwt}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"primary_id\": \"{{opponent_primary_id}}\",\n  \"secondary_id\": \"{{opponent_secondary_id}}\",\n  \"boosts\": []\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/battles/{{battle_id}}/accept", "host": ["{{base_url}}"], "path": ["api", "battles", "{{battle_id}}", "accept"] }
      },
      "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"battle_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"status\": \"in_progress\",\n  \"turn\": \"11111111-1111-4111-8111-111111111111\",\n  \"state\": {\n    \"challenger_hp\": 340,\n    \"opponent_hp\": 310\n  }\n}" }]
    },
    {
      "name": "Get Battle State",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().battle_id).to.eql(pm.collectionVariables.get(\"battle_id\"));"] } }],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/battles/{{battle_id}}", "host": ["{{base_url}}"], "path": ["api", "battles", "{{battle_id}}"] }
      },
      "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"battle_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"status\": \"in_progress\",\n  \"turn\": \"11111111-1111-4111-8111-111111111111\",\n  \"turn_number\": 1,\n  \"participants\": [\n    {\n      \"user_id\": \"11111111-1111-4111-8111-111111111111\",\n      \"primary\": { \"tamagotchi_id\": \"11111111-aaaa-4aaa-8aaa-111111111111\", \"type\": \"flame\", \"level\": 12, \"hp\": 340 },\n      \"secondary\": { \"tamagotchi_id\": \"11111111-bbbb-4bbb-8bbb-111111111111\", \"type\": \"water\", \"level\": 8 }\n    }\n  ]\n}" }]
    },
    {
      "name": "Perform a Turn",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.have.property(\"damage_dealt\");"] } }],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"user_id\": \"{{challenger_id}}\",\n  \"action\": \"attack\",\n  \"source\": \"primary\",\n  \"boost_id\": null\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{base_url}}/api/battles/{{battle_id}}/turns", "host": ["{{base_url}}"], "path": ["api", "battles", "{{battle_id}}", "turns"] },
        "description": "Set jwt and user_id to the participant whose turn is reported by Get Battle State."
      },
      "response": [
        { "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"turn_number\": 2,\n  \"damage_dealt\": 47,\n  \"type_multiplier\": 1.5,\n  \"boost_multiplier\": 1.0,\n  \"stat_bonus\": 1.1,\n  \"opponent_hp\": 263,\n  \"next_turn\": \"22222222-2222-4222-8222-222222222222\",\n  \"battle_over\": false\n}" },
        { "name": "409 Not this player's turn", "status": "Conflict", "code": 409, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"error\": \"Not this player's turn.\"\n}" }
      ]
    },
    {
      "name": "Get Battle Result",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 200 for a completed battle\", () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.have.property(\"winner_id\");"] } }],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/battles/{{battle_id}}/result", "host": ["{{base_url}}"], "path": ["api", "battles", "{{battle_id}}", "result"] },
        "description": "Run after the battle has finished."
      },
      "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"battle_id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n  \"winner_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"loser_id\": \"22222222-2222-4222-8222-222222222222\",\n  \"rewards\": {\n    \"winner\": {\n      \"global_currency\": 120,\n      \"xp\": { \"primary\": 60, \"secondary\": 40 },\n      \"captured_tamagotchi_id\": \"22222222-aaaa-4aaa-8aaa-222222222222\"\n    },\n    \"loser\": {\n      \"global_currency\": -60,\n      \"xp\": { \"primary\": 24, \"secondary\": 16 }\n    }\n  },\n  \"finished_at\": \"2026-09-24T12:10:00Z\"\n}" }]
    },
    {
      "name": "Forfeit",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Forfeit succeeds\", () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));"] } }],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
        "method": "POST",
        "header": [],
        "url": { "raw": "{{base_url}}/api/battles/{{battle_id}}/forfeit", "host": ["{{base_url}}"], "path": ["api", "battles", "{{battle_id}}", "forfeit"] },
        "description": "Alternative to playing the battle to completion. Do not run after Get Battle Result for the same battle."
      },
      "response": [{ "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "" }]
    }
  ],
  "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
      "// Generates the JWTs this collection needs, signed with the stack secrets.",
      "// Set jwt_secret / service_jwt_secret to the values in your .env.",
      "const TOKENS = {\"jwt\":{\"sub\":\"challenger_id\"},\"opponent_jwt\":{\"sub\":\"opponent_id\"}};",
      "const DEFAULT_PACKAGE = 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';",
      "const v = (k) => pm.variables.get(k) || \"\";",
      "const b64url = (w) => CryptoJS.enc.Base64.stringify(w).split(\"=\").join(\"\").split(\"+\").join(\"-\").split(\"/\").join(\"_\");",
      "const enc = (o) => b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(o)));",
      "const sign = (claims, secret) => {",
      "  const body = enc({ alg: \"HS256\", typ: \"JWT\" }) + \".\" + enc(claims);",
      "  return body + \".\" + b64url(CryptoJS.HmacSHA256(body, secret));",
      "};",
      "const now = Math.floor(Date.now() / 1000);",
      "Object.entries(TOKENS).forEach(([name, t]) => {",
      "  const claims = t.service",
      "    ? { sub: \"postman\", roles: [\"service\"] }",
      "    : { sub: t.subValue || v(t.sub), package_id: v(\"package_id\") || DEFAULT_PACKAGE, roles: t.roles || [\"user\"] };",
      "  claims.iat = now;",
      "  claims.exp = now + 3600;",
      "  pm.collectionVariables.set(name, sign(claims, v(t.service ? \"service_jwt_secret\" : \"jwt_secret\")));",
      "});"
    ] } }],
  "variable": [
    { "key": "jwt_secret", "value": "change_me_to_a_secret_with_at_least_32_characters", "type": "string", "description": "Must equal JWT_SECRET in the stack .env; used to sign user tokens." },
    { "key": "service_jwt_secret", "value": "change_me_to_a_service_secret_at_least_32_chars", "type": "string", "description": "Must equal SERVICE_JWT_SECRET in the stack .env; used to sign service tokens." },
    { "key": "base_url", "value": "http://localhost:8082", "type": "string" },
    { "key": "jwt", "value": "", "type": "string", "description": "Challenger JWT; keep empty in the exported collection." },
    { "key": "opponent_jwt", "value": "", "type": "string", "description": "Opponent JWT; keep empty in the exported collection." },
    { "key": "challenger_id", "value": "11111111-1111-4111-8111-111111111111", "type": "string" },
    { "key": "opponent_id", "value": "22222222-2222-4222-8222-222222222222", "type": "string" },
    { "key": "challenger_primary_id", "value": "11111111-aaaa-4aaa-8aaa-111111111111", "type": "string" },
    { "key": "challenger_secondary_id", "value": "11111111-bbbb-4bbb-8bbb-111111111111", "type": "string" },
    { "key": "opponent_primary_id", "value": "22222222-aaaa-4aaa-8aaa-222222222222", "type": "string" },
    { "key": "opponent_secondary_id", "value": "22222222-bbbb-4bbb-8bbb-222222222222", "type": "string" },
    { "key": "battle_id", "value": "", "type": "string", "description": "Filled by Create a Battle." }
  ]
}
