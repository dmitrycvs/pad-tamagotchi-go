{
  "info": {
    "_postman_id": "e45b8004-9842-4fce-bc86-ffdf95ba2d70",
    "name": "Tamagotchi Go — Map Service",
    "description": "Requests for the Map Service communication contract. Includes health check, continuous location update reporting, proximity queries, and single user location lookup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Public health check endpoint."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"status\": \"ok\"\n}"
        }
      ]
    },
    {
      "name": "Push a Location Update",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK or 202 Accepted\", () => {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"latitude\": 47.02167,\n  \"longitude\": 28.84353,\n  \"accuracy_meters\": 8.0,\n  \"recorded_at\": \"{{$isoTimestamp}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/map/locations",
          "host": ["{{base_url}}"],
          "path": ["api", "map", "locations"]
        },
        "description": "Continuous geolocation feed from the client. Requires user JWT."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"user_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"accepted\": true,\n  \"proximity_events\": [\n    {\n      \"event_id\": \"evt-uuid-prox-001\",\n      \"other_user_id\": \"22222222-2222-4222-8222-222222222222\",\n      \"distance_meters\": 4.2,\n      \"relation\": \"none\",\n      \"suggestion\": [\"befriend\", \"battle\"]\n    }\n  ]\n}"
        },
        {
          "name": "202 Accepted (stale)",
          "status": "Accepted",
          "code": 202,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"accepted\": false,\n  \"reason\": \"stale_location\"\n}"
        },
        {
          "name": "401 Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"error\": \"Unauthorized.\"\n}"
        }
      ]
    },
    {
      "name": "Get Nearby Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response contains nearby list\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"nearby\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/map/nearby?user_id={{user_id}}&radius_meters={{radius_meters}}",
          "host": ["{{base_url}}"],
          "path": ["api", "map", "nearby"],
          "query": [
            { "key": "user_id", "value": "{{user_id}}" },
            { "key": "radius_meters", "value": "{{radius_meters}}" }
          ]
        },
        "description": "Friends/enemies are returned regardless of distance; unknown users appear within proximity threshold."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"user_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"nearby\": [\n    {\n      \"user_id\": \"22222222-2222-4222-8222-222222222222\",\n      \"username\": \"kiki\",\n      \"relation\": \"friend\",\n      \"latitude\": 47.0218,\n      \"longitude\": 28.8436,\n      \"distance_meters\": 18.4,\n      \"last_seen\": \"2026-09-09T12:29:50Z\"\n    }\n  ]\n}"
        }
      ]
    },
    {
      "name": "Get User Last Known Location",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK or 404 Not Found\", () => {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{service_jwt}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/map/users/{{user_id}}/location",
          "host": ["{{base_url}}"],
          "path": ["api", "map", "users", "{{user_id}}", "location"]
        },
        "description": "Requires service JWT. Used by other microservices to query a user's latest location."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"user_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"latitude\": 47.02167,\n  \"longitude\": 28.84353,\n  \"recorded_at\": \"2026-09-09T12:30:00Z\",\n  \"stale\": false\n}"
        },
        {
          "name": "404 Not Found",
          "status": "Not Found",
          "code": 404,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"error\": \"No fresh location for this user.\"\n}"
        }
      ]
    }
  ],
  "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
      "// Generates the JWTs this collection needs, signed with the stack secrets.",
      "// Set jwt_secret / service_jwt_secret to the values in your .env.",
      "const TOKENS = {\"jwt\":{\"sub\":\"user_id\"},\"service_jwt\":{\"service\":true}};",
      "const DEFAULT_PACKAGE = 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';",
      "const v = (k) => pm.variables.get(k) || \"\";",
      "const b64url = (w) => CryptoJS.enc.Base64.stringify(w).split(\"=\").join(\"\").split(\"+\").join(\"-\").split(\"/\").join(\"_\");",
      "const enc = (o) => b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(o)));",
      "const sign = (claims, secret) => {",
      "  const body = enc({ alg: \"HS256\", typ: \"JWT\" }) + \".\" + enc(claims);",
      "  return body + \".\" + b64url(CryptoJS.HmacSHA256(body, secret));",
      "};",
      "const now = Math.floor(Date.now() / 1000);",
      "Object.entries(TOKENS).forEach(([name, t]) => {",
      "  const claims = t.service",
      "    ? { sub: \"postman\", roles: [\"service\"] }",
      "    : { sub: t.subValue || v(t.sub), package_id: v(\"package_id\") || DEFAULT_PACKAGE, roles: t.roles || [\"user\"] };",
      "  claims.iat = now;",
      "  claims.exp = now + 3600;",
      "  pm.collectionVariables.set(name, sign(claims, v(t.service ? \"service_jwt_secret\" : \"jwt_secret\")));",
      "});"
    ] } }],
  "variable": [
    { "key": "jwt_secret", "value": "change_me_to_a_secret_with_at_least_32_characters", "type": "string", "description": "Must equal JWT_SECRET in the stack .env; used to sign user tokens." },
    { "key": "service_jwt_secret", "value": "change_me_to_a_service_secret_at_least_32_chars", "type": "string", "description": "Must equal SERVICE_JWT_SECRET in the stack .env; used to sign service tokens." },
    { "key": "base_url", "value": "http://localhost:8085", "type": "string" },
    { "key": "jwt", "value": "", "type": "string", "description": "User JWT; keep empty in exported collection." },
    { "key": "service_jwt", "value": "", "type": "string", "description": "Service-to-service JWT; keep empty in exported collection." },
    { "key": "user_id", "value": "11111111-1111-4111-8111-111111111111", "type": "string" },
    { "key": "radius_meters", "value": "500", "type": "string" }
  ]
}
