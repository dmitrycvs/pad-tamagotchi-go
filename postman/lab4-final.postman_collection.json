{
  "info": {
    "name": "Lab 4 final check",
    "description": "One run checks the whole Lab 4 system, grade by grade: gateway to broker queues, gRPC registration, internal routes, log download, topics, durable queues and dead letters, load-based routing and monitoring. Select the local Tamagotchi environment (jwt_secret and service_jwt_secret from .env) and run the whole collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Signs admin_jwt and service_jwt with the stack secrets (a local environment, never exported).",
          "// The user token (jwt) comes from the login request. Health and monitoring requests need no secrets.",
          "const v = (k) => pm.variables.get(k) || '';",
          "const raw = JSON.stringify(pm.request.toJSON());",
          "const needs = { admin_jwt: 'jwt_secret', service_jwt: 'service_jwt_secret' };",
          "const b64url = (w) => CryptoJS.enc.Base64.stringify(w).split('=').join('').split('+').join('-').split('/').join('_');",
          "const enc = (o) => b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(o)));",
          "const sign = (claims, secret) => {",
          "  const body = enc({ alg: 'HS256', typ: 'JWT' }) + '.' + enc(claims);",
          "  return body + '.' + b64url(CryptoJS.HmacSHA256(body, secret));",
          "};",
          "const now = Math.floor(Date.now() / 1000);",
          "for (const [name, secretKey] of Object.entries(needs)) {",
          "  if (!raw.includes('{{' + name + '}}')) continue;",
          "  if (v(secretKey).length < 32) {",
          "    throw new Error('Select the local Tamagotchi environment: ' + secretKey + ' must match .env (at least 32 characters).');",
          "  }",
          "  const claims = name === 'service_jwt'",
          "    ? { sub: 'postman', roles: ['service'] }",
          "    : { sub: v('user_id') || 'postman-admin', package_id: v('package_id'), roles: ['user', 'admin'] };",
          "  claims.iat = now;",
          "  claims.exp = now + 3600;",
          "  pm.collectionVariables.set(name, sign(claims, v(secretKey)));",
          "}"
        ]
      }
    }
  ],
  "item": [
